# Borepix environment variables.
# Copy to .env.local for development. Every file matching .env* except this example is git-ignored.
#
# Rule: only NEXT_PUBLIC_* values reach the browser, so a private key must NEVER carry that prefix.
# `npm run build` runs scripts/check-env.mjs first and fails if a NEXT_PUBLIC_ name looks like a secret
# or a credential literal is found in src/.

# Public, safe for the browser. Used for canonical URLs, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.borepix.com

# Server-only. Gates the founder dashboard at /admin (see src/proxy.ts).
# Visit /admin?key=<this value> once; a secure HTTP-only cookie then keeps you signed in for 12 hours.
# In production the dashboard is unreachable until this is set.
ADMIN_ACCESS_KEY=

# Server-only placeholders for launch. Leave unset until the backend exists; never add NEXT_PUBLIC_.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# DATABASE_URL=
# AUTH_SECRET=
